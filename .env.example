# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# .env is git-ignored and never committed. In production the orchestrator
# injects these as environment variables instead of using a file.

# --- Database credentials ---------------------------------------------------
# Used by both PostgreSQL containers and by the connection strings that
# docker-compose builds for the services.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

EXPENSE_DB_NAME=expense_db
USERS_DB_NAME=users_db

# Host ports the database containers are published on. The containers always
# listen on 5432 internally; these are only for tools you run on your machine
# (alembic, psql, uvicorn) via the host-facing URLs below.
EXPENSE_DB_PORT=5433
USERS_DB_PORT=5434

# --- Shared auth settings ---------------------------------------------------
# Both services MUST use the same SECRET_KEY: the auth service signs JWTs and
# the expense service verifies them.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Host-facing database URLs ----------------------------------------------
# For tools you run from your machine, not from inside Docker. The services
# running in containers get their own URLs from docker-compose.yml, which
# reach the databases by service name instead of localhost.
EXPENSE_DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5433/expense_db
USER_DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5434/users_db
